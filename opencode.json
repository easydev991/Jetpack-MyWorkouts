{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "environment": {
        "MOBILEMCP_DISABLE_TELEMETRY": "1",
        "MOBILEMCP_ALLOW_UNSAFE_URLS": "1"
      },
      "enabled": true,
      "timeout": 120000
    },
    "xcode": {
      "enabled": false
    },
    "xcodebuild-mcp": {
      "enabled": false
    },
    "gitlab": {
      "enabled": false
    }
  },
  "instructions": [".opencode/rules/*.md"]
}